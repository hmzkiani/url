{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/r/:code",
      "destination": "/api/index.js"
    },
    {
      "source": "/r",
      "destination": "/url-shortener"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
