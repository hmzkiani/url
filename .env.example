# ===================================================================
# SEOFlow Tools - Environment Variables Configuration
# ===================================================================

# [Production Only] Custom Deployed Website Domain (No trailing slash)
# If left empty, the application automatically uses the current deployed origin (e.g. window.location.origin).
# When deploying to Netlify with a custom domain, set this in:
# Netlify Dashboard -> Site Configuration -> Environment Variables
# Example: https://seoflow.tools OR https://your-site.netlify.app
VITE_SITE_URL=

# [Server Companion API] Optional port for companion backend (Defaults to 3001)
PORT=3001
