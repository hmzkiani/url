# ===================================================================
# SEOFlow Tools - Environment Variables Configuration
# ===================================================================

# [Production Only] Custom Deployed Website Domain (No trailing slash)
# If left empty, the application automatically uses the current deployed origin (e.g. window.location.origin).
# When deploying to Vercel or Netlify with a custom domain, set this in:
# Vercel: Project Settings -> Environment Variables
# Netlify: Site Configuration -> Environment Variables
# Example: https://url-dun-omega.vercel.app OR https://your-custom-domain.com
VITE_SITE_URL=

# [Persistent Short Links Storage on Vercel Serverless]
# By default, links are cached in memory and saved to /tmp and shortlinks.json.
# For permanent cross-container storage across Vercel cold starts, connect
# Vercel KV or Upstash Redis (Vercel Dashboard -> Storage -> Create KV Database):
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Or Upstash Redis REST API credentials:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# [Server Companion API] Optional port for local development backend (Defaults to 3001)
PORT=3001
